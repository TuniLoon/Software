{
    "project": {
        "name": "TuniLoon",
        "version": "1.0.0",
        "identifier": "TUN"
    },
    "payload": {
        "transmission_interval": 30,
        "max_altitude": 30000,
        "launch_site": {
            "latitude": 35.8276,
            "longitude": 10.6402,
            "name": "Sousse, Tunisia"
        }
    },
    "communication": {
        "virtual_com_port": "COM10",
        "baud_rate": 115200,
        "packet_timeout": 60
    },
    "telemetry": {
        "fields": [
            "identifier",
            "latitude",
            "longitude",
            "altitude",
            "pressure",
            "temperature",
            "humidity",
            "thermal_avg",
            "checksum",
            "status"
        ],
        "status_codes": {
            "A": "Ascent",
            "D": "Descent",
            "L": "Landing",
            "E": "Error",
            "F": "Cut-down"
        }
    },
    "logging": {
        "data_dir": "data/",
        "csv_filename": "flight_data.csv",
        "log_interval": 1
    },
    "cloud": {
        "mqtt_broker": "broker.hivemq.com",
        "mqtt_port": 1883,
        "topic": "tuniloon/telemetry"
    },
    "alerts": {
        "telegram_bot_token": "YOUR_BOT_TOKEN",
        "telegram_chat_id": "YOUR_CHAT_ID",
        "max_altitude_alert": true,
        "landing_alert": true
    },
    "ground_station": {
        "web_port": 5000,
        "update_interval": 1
    }
}
