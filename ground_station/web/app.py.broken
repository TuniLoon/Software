@app.route('/api/test/summary')
def test_summary():
    from analysis.flight_analyzer import FlightAnalyzer
    from analysis.wind_estimator import WindEstimator
    history = db.get_history(current_flight_id, limit=None)
    if not history: return jsonify({'error':'No flight data'})
    metrics = FlightAnalyzer(history).get_metrics()
    wind_speed, wind_direction = WindEstimator(history).get_wind()
    return jsonify({'metrics': metrics, 'wind_speed': wind_speed, 'wind_direction': wind_direction})

def process_packet(packet_string: str):
    global current_flight_id, packet_counter, summary_sent, last_summary_time, has_reached_altitude
    try:
        data = decoder.decode(packet_string)
        if data is None: return
        if 'timestamp' not in data: data['timestamp'] = datetime.now().isoformat()
        packet_counter += 1
        if data.get('altitude', 0) > 1000: has_reached_altitude = True

        if anomaly_detector.is_initialized:
            anomaly_result = anomaly_detector.process_telemetry(data)
            confidence_threshold = config.ANOMALY_CONFIDENCE_THRESHOLD
            is_anomaly = anomaly_result['is_anomaly'] and anomaly_result['confidence'] > confidence_threshold
            data['anomaly'] = bool(is_anomaly)
            data['anomaly_score'] = float(anomaly_result['anomaly_score'])
            data['anomaly_confidence'] = float(anomaly_result['confidence'])
            if anomaly_result['alert_triggered']:
                logger.info(f"ANOMALY detected in packet {packet_counter}")
                if telegram_bot.enabled:
                    telegram_bot.send_message(
                        f"🚨 <b>Anomaly Detected!</b>\n\n"
                        f"Alt: {data['altitude']:.0f}m, Temp: {data['temperature']:.1f}°C\n"
                        f"Score: {data['anomaly_score']:.2f}, Confidence: {data['anomaly_confidence']:.2f}"
                    )
        else:
            data['anomaly'] = False
            data['anomaly_score'] = 0.0
            data['anomaly_confidence'] = 0.0

        db.insert_telemetry(current_flight_id, data)
        logger_telemetry.log(data)

        if not summary_sent and has_reached_altitude and data['altitude'] < 50 and data['status'] == 'L':
            summary_sent = True
            last_summary_time = time.time()
            from analysis.flight_analyzer import FlightAnalyzer
            from analysis.wind_estimator import WindEstimator
            history = db.get_history(current_flight_id, limit=None)
            if history:
                analyzer = FlightAnalyzer(history)
                metrics = analyzer.get_metrics()
                wind_speed, wind_direction = WindEstimator(history).get_wind()
                duration_min = metrics.get('duration_hours', 0) * 60
                max_alt = metrics.get('max_altitude', 0)
                max_temp = metrics.get('max_temperature', 0)
                min_temp = metrics.get('min_temperature', 0)
                avg_ascent = metrics.get('avg_ascent_rate', 0)
                avg_descent = metrics.get('avg_descent_rate', 0)
                distance = metrics.get('total_distance_km', 0)
                landing_lat, landing_lon = metrics.get('landing_location', (0,0))
                msg = (
                    f"🛬 <b>Flight Summary</b>\n\n"
                    f"Duration: {duration_min:.1f} min\n"
                    f"Max Altitude: {max_alt:.0f} m\n"
                    f"Max Temp: {max_temp:.1f} °C\n"
                    f"Min Temp: {min_temp:.1f} °C\n"
                    f"Avg Ascent Rate: {avg_ascent:.1f} m/s\n"
                    f"Avg Descent Rate: {avg_descent:.1f} m/s\n"
                    f"Total Distance: {distance:.2f} km\n"
                    f"Landing Location: ({landing_lat:.4f}, {landing_lon:.4f})\n"
                    f"Wind (est.): {wind_speed:.1f} m/s from {wind_direction:.0f}°"
                )
                if telegram_bot.enabled:
                    telegram_bot.send_message(msg)
                    logger.info("Flight summary sent via Telegram")
                else:
                    logger.warning("Telegram disabled – summary not sent")

        
        # Reset summary flags for new flight (if we already sent one and see another landing)
        if summary_sent and data['altitude'] < 50 and data['status'] == 'L':
            if time.time() - last_summary_time > 5:
                summary_sent = False
                has_reached_altitude = False
                logger.info("New flight detected – summary flags reset")

        logger.info(f"Packet {packet_counter}: Alt={data['altitude']}m, Status={data['status']}")
    except Exception as e:
        logger.error(f"Error processing packet: {e}\n{traceback.format_exc()}")

def run_mock_consumer():
    global simulation_real_time, summary_sent, has_reached_altitude
    import sys
    from pathlib import Path
    sys.path.append(str(config.BASE_DIR))
    from payload_simulator.src.MockPayload import MockPayload
    run_mock_consumer.running = True
    packet_interval = config.SIMULATION_INTERVAL
    logger.info("Mock consumer started.")
    payload = MockPayload(continuous=True)
    payload.generate_flight()
    mqtt_publisher.connect()
    while run_mock_consumer.running:
        try:
            data = payload.get_next_packet()
            if data is None:
                payload.generate_flight()
                summary_sent = False
                has_reached_altitude = False
                last_summary_time = 0
                telegram_bot.reset_state()
                anomaly_detector.reset()
                continue
            packet = payload.packer.pack_from_dict(data)
            process_packet(packet)
            if simulation_real_time:
                time.sleep(30)
            else:
                time.sleep(packet_interval)
        except Exception as e:
            logger.error(f"Mock consumer error: {e}\n{traceback.format_exc()}")
            time.sleep(1)

def run_mock_consumer_thread():
    run_mock_consumer.running = True
    thread = threading.Thread(target=run_mock_consumer)
    thread.daemon = True
    thread.start()
    return thread


@app.route('/api/weather/key')
def weather_key():
    return jsonify({'key': config.OPENWEATHER_API_KEY})


